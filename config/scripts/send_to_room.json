{
  "name": "send_to_room",
  "variables": [
    {
      "name": "room",
      "type": "str"
    },
    {
      "name": "msg",
      "type": "str"
    },
    {
      "name": "msg2",
      "type": "str"
    }
  ],
  "commands": [
    "socketio_send $room$ $msg$",
    "echo Warte 20 sekunden",
    "sleep 20",
    "socketio_send $room$ $msg2$"
  ]
}
